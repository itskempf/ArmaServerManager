<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Color x:Key="SystemAccentColor">#0078D4</Color>
    <Color x:Key="SystemAccentColorLight1">#40E0FF</Color>
    <Color x:Key="SystemAccentColorLight2">#99EBFF</Color>
    <Color x:Key="SystemAccentColorLight3">#CCF5FF</Color>
    <Color x:Key="SystemAccentColorDark1">#005A9E</Color>
    <Color x:Key="SystemAccentColorDark2">#004578</Color>
    <Color x:Key="SystemAccentColorDark3">#003E52</Color>

    <!-- Custom Brushes -->
    <SolidColorBrush x:Key="ArmaAccentBrush" Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="ArmaSecondaryBrush" Color="#FF2196F3"/>
    <SolidColorBrush x:Key="ArmaWarningBrush" Color="#FFFF9800"/>
    <SolidColorBrush x:Key="ArmaErrorBrush" Color="#FFF44336"/>

    <!-- Card Styles -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    </Style>

    <!-- Button Styles -->
    <Style x:Key="ArmaAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ArmaAccentBrush}"/>
    </Style>

    <!-- Smooth Transitions -->
    <Storyboard x:Key="ThemeTransitionStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="1.0" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    
    <!-- Page Transition -->
    <Storyboard x:Key="PageTransitionStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Progress Ring Style -->
    <Style x:Key="ArmaProgressRingStyle" TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{StaticResource ArmaAccentBrush}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <!-- Consistent Margins -->
    <Thickness x:Key="StandardMargin">16</Thickness>
    <Thickness x:Key="SmallMargin">8</Thickness>
    <Thickness x:Key="LargeMargin">24</Thickness>
    
    <!-- Adaptive Scaling -->
    <Style x:Key="AdaptiveTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <Style x:Key="AdaptiveHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="{StaticResource LargeMargin}"/>
    </Style>
    
    <!-- Consistent Button Spacing -->
    <Style x:Key="ButtonPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="12"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

</ResourceDictionary>