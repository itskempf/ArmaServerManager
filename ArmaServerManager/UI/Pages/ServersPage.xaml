<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArmaServerManager.UI.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="Server Management" FontSize="24" FontWeight="Bold"/>
            
            <!-- Profile Management -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Server Profiles" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox PlaceholderText="Select Profile" MinWidth="150">
                            <ComboBoxItem Content="Default"/>
                            <ComboBoxItem Content="PvP Setup"/>
                            <ComboBoxItem Content="Co-op Mission"/>
                        </ComboBox>
                        <Button Content="Save Profile"/>
                        <Button Content="Load Profile"/>
                        <Button Content="Add New Server" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Server List -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Active Servers" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="ServersList" MaxHeight="300" ItemsSource="{Binding Servers}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="12" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="12"/>
                                            <TextBlock Text="{Binding PlayerInfo}" Opacity="0.5" FontSize="10"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Content="Start" IsEnabled="{Binding CanStart}" Click="StartServer_Click" Tag="{Binding}"/>
                                            <Button Content="Stop" IsEnabled="{Binding CanStop}" Click="StopServer_Click" Tag="{Binding}"/>
                                            <Button Content="Configure" Click="ConfigureServer_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            
            <!-- Advanced Settings -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Advanced Settings" FontSize="16" FontWeight="SemiBold"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- CPU Settings -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="CPU Cores" Margin="0,0,0,4"/>
                            <NumberBox x:Name="CpuCoresBox" Value="4" Minimum="1" Maximum="32"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                            <TextBlock Text="Memory Limit (MB)" Margin="0,0,0,4"/>
                            <NumberBox x:Name="MemoryLimitBox" Value="2048" Minimum="512" Maximum="32768"/>
                        </StackPanel>
                        
                        <!-- Headless Client Settings -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="Headless Clients" Margin="0,0,0,4"/>
                            <NumberBox x:Name="HeadlessClientsBox" Value="0" Minimum="0" Maximum="8"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                            <TextBlock Text="Server Port" Margin="0,0,0,4"/>
                            <NumberBox x:Name="ServerPortBox" Value="2302" Minimum="1024" Maximum="65535"/>
                        </StackPanel>
                        
                        <!-- Additional Options -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <CheckBox Content="Enable BattlEye" IsChecked="True" Margin="0,0,0,4"/>
                            <CheckBox Content="Enable Persistent" IsChecked="False" Margin="0,0,0,4"/>
                            <CheckBox Content="Auto-restart on crash" IsChecked="True" Margin="0,0,0,4"/>
                            <CheckBox Content="Enable file patching" IsChecked="False"/>
                        </StackPanel>
                        
                        <!-- Command Line Parameters -->
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                            <TextBlock Text="Additional Parameters" Margin="0,0,0,4"/>
                            <TextBox x:Name="AdditionalParamsBox" PlaceholderText="-world=empty -autoInit" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Apply Settings" Style="{StaticResource AccentButtonStyle}" Click="ApplySettings_Click"/>
                        <Button Content="Reset to Defaults" Click="ResetToDefaults_Click"/>
                        <Button Content="Create Backup" Click="CreateBackup_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>